# Backend API base URL (required — the app is API-only)
EXPO_PUBLIC_API_URL=

# Optional: shared secret for the destructive POST /system/reset endpoint.
# Only needed if the backend has ADMIN_RESET_TOKEN configured. NOTE: values are
# inlined into the build, so this is not a true secret — it only blocks callers
# who don't know the token (adequate for a Tailscale/LAN homelab).
EXPO_PUBLIC_ADMIN_RESET_TOKEN=

# Path used by the codegen script (npm run gen:api). Local dev path only —
# no EXPO_PUBLIC_ prefix, so it is never inlined into the app.
CALIMALI_OPENAPI=../calimali-backend/openapi.json
